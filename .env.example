# ==============================================================================
# ZUNO ERP — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# DATABASE 1: Operational Database (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Primary operational database connection string (with pooler / direct fallback)
NEON_DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/zuno_operational?sslmode=require&connect_timeout=15

# Direct connection for schema migrations (Neon non-pooler)
NEON_DIRECT_URL=postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/zuno_operational?sslmode=require

# ------------------------------------------------------------------------------
# DATABASE 2: Historical & Archival Database (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Dedicated historical database for statutory, compliance, and archived records
SUPABASE_HISTORY_DATABASE_URL=postgresql://postgres.history_project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Storage / Auth Keys (if invoking historical bucket storage)
SUPABASE_URL=https://sample-history.supabase.co
SUPABASE_ANON_KEY=sample_anon_key_for_history
SUPABASE_SERVICE_ROLE_KEY=sample_service_role_key_for_history

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Primary JWT Secret for short-lived access tokens (15-30m)
JWT_SECRET=zuno_super_secret_enterprise_jwt_signing_key_min_32_chars_2026!
JWT_EXPIRES_IN=15m

# Rotating Refresh Token Secret (7d)
JWT_REFRESH_SECRET=zuno_refresh_token_rotation_super_secret_vault_key_2026!
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing configuration (Argon2 / bcrypt work factor)
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY INTEGRATION (Razorpay / Stripe)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=sample_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=sample_webhook_signing_secret_for_idempotent_inbox

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL & SMS / OTP SERVICES
# ------------------------------------------------------------------------------
EMAIL_SERVICE_PROVIDER=resend
RESEND_API_KEY=re_sample_resend_api_key
MAIL_FROM_ADDRESS=notifications@zunoerp.com
MAIL_FROM_NAME="Zuno ERP Cloud"

SMS_OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_sample_twilio_sid
TWILIO_AUTH_TOKEN=sample_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# OBJECT STORAGE (Private S3-Compatible Storage for Secure Documents)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=zuno-tenant-private-vault
STORAGE_ACCESS_KEY_ID=sample_aws_s3_key_id
STORAGE_SECRET_ACCESS_KEY=sample_aws_s3_secret_access_key

# ------------------------------------------------------------------------------
# BACKGROUND WORKER & OUTBOX POLLING
# ------------------------------------------------------------------------------
ARCHIVE_WORKER_INTERVAL_MS=30000
ARCHIVE_BATCH_SIZE=100
ARCHIVE_MAX_RETRIES=5

