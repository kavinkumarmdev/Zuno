FROM node:22-alpine AS builder

WORKDIR /app

# Copy root and workspace packages
COPY package*.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/
COPY database/ ./database/

RUN npm install --no-audit --no-fund
RUN npm run build --workspace=@zuno/shared-types
RUN npm run build --workspace=@zuno/shared-validation
RUN npm run build --workspace=@zuno/ui

WORKDIR /app/apps/api
RUN npx prisma generate --schema=../../database/main/schema.prisma
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package*.json ./apps/api/
COPY --from=builder /app/database ./database

EXPOSE 4000
CMD ["node", "apps/api/dist/main"]

