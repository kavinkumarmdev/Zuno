// ==============================================================================
// ZUNO ERP — PRISMA ORM SCHEMA (ALL 243 OPERATIONAL TABLES)
// Provider: PostgreSQL (Neon Operational Database)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NEON_DATABASE_URL")
}

/// Table: tb_tenant (Phase 1 - Company Management)
/// A customer account boundary that owns one or more companies in Zuno.
model TbTenant {
  id String @id @default(uuid()) @db.Uuid
  tenant_code String? @db.VarChar(30)
  tenant_name String? @db.VarChar(200)
  account_status String? @db.VarChar(30) @default("ACTIVE")
  registration_source String? @db.VarChar(30)
  registered_time DateTime? @db.Timestamptz(6)
  activated_time DateTime? @db.Timestamptz(6)
  suspended_time DateTime? @db.Timestamptz(6)
  suspension_reason String? @db.Text
  created_time DateTime @default(now()) @db.Timestamptz(6)
  updated_time DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  @@map("tb_tenant")
}

/// Table: tb_tenant_owner (Phase 1 - Company Management)
/// Owner and primary contact details for a tenant account.
model TbTenantOwner {
  id String @id @default(uuid()) @db.Uuid
  tenant_id String? @db.Uuid
  owner_name String? @db.VarChar(150)
  email String? @db.VarChar(150)
  mobile String? @db.VarChar(20)
  designation String? @db.VarChar(100)
  is_primary Boolean? @default(false)
  is_verified Boolean? @default(false)
  created_time DateTime @default(now()) @db.Timestamptz(6)
  @@map("tb_tenant_owner")
}

/// Table: tb_company (Phase 1 - Company Management)
/// Legal/business entity registered under a tenant.
model TbCompany {
  id String @id @default(uuid()) @db.Uuid
  tenant_id String? @db.Uuid
  company_code String? @db.VarChar(30)
  company_name String? @db.VarChar(200)
  legal_name String? @db.VarChar(200)
  business_type String? @db.VarChar(50)
  ownership_type String? @db.VarChar(50)
  industry_type String? @db.VarChar(100)
  pan_number String? @db.VarChar(20)
  tan_number String? @db.VarChar(20)
  gstin String? @db.VarChar(20)
  cin_number String? @db.VarChar(30)
  udyam_number String? @db.VarChar(30)
  incorporation_date DateTime? @db.Date
  financial_year_start DateTime? @db.Date
  currency_code String? @db.VarChar(3)
  country_code String? @db.VarChar(2)
  company_status String? @db.VarChar(30) @default("ACTIVE")
  created_by String? @db.Uuid
  created_time DateTime @default(now()) @db.Timestamptz(6)
  updated_by String? @db.Uuid
  updated_time DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  @@map("tb_company")
}

