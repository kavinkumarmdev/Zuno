{
  "name": "zuno-erp",
  "version": "1.0.0",
  "private": true,
  "description": "ZUNO ERP — Enterprise Multi-Tenant SaaS Business Management Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@zuno/api",
    "dev:web": "npm run dev --workspace=@zuno/web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=@zuno/api",
    "build:web": "npm run build --workspace=@zuno/web",
    "start": "node apps/api/dist/apps/api/src/main.js",
    "start:api": "node apps/api/dist/apps/api/src/main.js",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace=@zuno/api",
    "test:web": "npm run test --workspace=@zuno/web",
    "lint": "npm run lint --workspaces --if-present",
    "postinstall": "npm run db:generate || true",
    "db:generate": "npm run db:generate --workspace=@zuno/api",
    "db:migrate": "npm run db:migrate --workspace=@zuno/api",
    "db:seed": "npm run db:seed --workspace=@zuno/api"
  },
  "keywords": [
    "erp",
    "saas",
    "multi-tenant",
    "nestjs",
    "react",
    "prisma",
    "typescript"
  ],
  "author": "Zuno Team",
  "license": "Proprietary",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "pdf-parse": "^1.1.1"
  }
}
